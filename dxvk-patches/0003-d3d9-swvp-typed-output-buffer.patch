+      // view an R32_UINT format too; it still provides the raw descriptor otherwise.
+      viewKey.format = VK_FORMAT_R32_UINT;
+      viewKey.usage = VK_BUFFER_USAGE_STORAGE_TEXEL_BUFFER_BIT;
       viewKey.offset = cBufferSlice.offset();
       viewKey.size = cBufferSlice.length();
 
